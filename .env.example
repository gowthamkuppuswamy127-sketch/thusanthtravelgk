# Copy to .env and fill in. All values are optional.

# Public URL of the deployed site, used for canonical and share links.
SITE_URL=

# Passcode for the demo admin page at /admin. This check runs in the browser,
# so it is not real security. Replace with proper auth before storing real data.
PUBLIC_ADMIN_PASSCODE=tushanth-demo

# Optional: a free Web3Forms access key (https://web3forms.com). When set,
# every enquiry and newsletter sign-up is also emailed to the business.
PUBLIC_WEB3FORMS_KEY=
