---
import { Image } from 'astro:assets';
import Phone from '@lucide/astro/icons/phone';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import logoOnDark from '../assets/brand/logo-on-dark.png';
import logoOnLight from '../assets/brand/logo-on-light.png';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { nav, site, telHref, whatsappHref } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header on-dark fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4" data-header>
  <div class="mx-auto max-w-7xl">
    <nav
      class="nav-pill flex items-center justify-between gap-4 rounded-2xl py-1.5 pr-2 pl-3 sm:pl-4 lg:rounded-full lg:pl-6"
      aria-label="Main"
    >
      <a href="/" class="logo relative grid shrink-0 items-center" aria-label={`${site.name}, home`}>
        <Image src={logoOnDark} alt="" height={56} densities={[1, 2]} class="logo-on-dark h-11 w-auto sm:h-[52px]" loading="eager" />
        <Image src={logoOnLight} alt="" height={56} densities={[1, 2]} class="logo-on-light h-11 w-auto sm:h-[52px]" loading="eager" />
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', isActive(item.href) && 'is-active']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={telHref}
          class="hidden items-center gap-2 rounded-full px-3 py-2 text-sm font-medium text-fg/90 transition hover:text-accent xl:inline-flex"
        >
          <Phone size={16} />
          {site.phoneDisplay}
        </a>
        <a href="/contact#enquiry" class="btn btn-primary btn-sm hidden sm:inline-flex" data-enquire>
          Book now
        </a>
        <button
          type="button"
          class="menu-btn grid size-11 place-items-center rounded-full text-fg lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <span class="sr-only">Open menu</span>
          <Menu size={22} class="icon-open" />
          <X size={22} class="icon-close hidden" />
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="glass-strong mt-2 rounded-2xl p-3 lg:hidden" hidden data-mobile-menu>
      <ul class="grid gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'flex items-center justify-between rounded-xl px-4 py-3.5 text-lg font-medium transition hover:bg-fg/8',
                  isActive(item.href) ? 'text-accent' : 'text-fg',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
                <ArrowRight size={18} class="opacity-50" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-3 grid grid-cols-2 gap-2 border-t border-line pt-3">
        <a href={telHref} class="btn btn-ghost">
          <Phone size={17} /> Call
        </a>
        <a href={whatsappHref()} class="btn btn-ghost" target="_blank" rel="noopener">
          <WhatsAppIcon size={17} /> WhatsApp
        </a>
        <a href="/contact#enquiry" class="btn btn-primary col-span-2" data-enquire>Book now</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Over the hero the header is dark glass (`.on-dark`); once the page
     scrolls or the menu opens, site.ts drops `.on-dark` and it turns white.
     The switch is a cross-fade of opacity only (a white layer behind the
     pill, the two logos) so it runs on the compositor and stays smooth on
     phones; the icon colour eases on the same curve. */
  .nav-pill {
    --fade: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    isolation: isolate;
    background: rgb(11 22 41 / 0.28);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .nav-pill::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: #ffffff;
    border: 1px solid #e1e9f3;
    box-shadow: 0 18px 40px -26px rgb(15 29 51 / 0.45);
    opacity: 1;
    transition: opacity var(--fade);
  }
  .on-dark .nav-pill::before {
    opacity: 0;
  }
  @media (min-width: 1024px) {
    .nav-pill {
      -webkit-backdrop-filter: blur(16px) saturate(150%);
      backdrop-filter: blur(16px) saturate(150%);
    }
  }
  @media (max-width: 1023px) {
    /* No backdrop blur on phones: it re-renders every frame over the hero video and while scrolling. */
    .on-dark .nav-pill {
      background: rgb(11 22 41 / 0.42);
    }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .on-dark .nav-pill {
      background: rgb(11 22 41 / 0.92);
    }
  }
  .logo > :global(img) {
    grid-area: 1 / 1;
    transition: opacity var(--fade);
  }
  .on-dark :global(.logo-on-light),
  .site-header:not(.on-dark) :global(.logo-on-dark) {
    opacity: 0;
    pointer-events: none;
  }
  .menu-btn {
    transition:
      color var(--fade),
      background-color 0.2s ease;
  }
  @media (hover: hover) {
    .menu-btn:hover {
      background: color-mix(in srgb, var(--color-fg) 10%, transparent);
    }
  }
  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--color-fg) 82%, transparent);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .nav-link:hover {
    color: var(--color-fg);
    background: color-mix(in srgb, var(--color-fg) 7%, transparent);
  }
  .nav-link.is-active {
    color: var(--color-accent);
  }
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.2rem;
    width: 1.1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    transform: translateX(-50%);
  }
  [data-menu-open] :global(.icon-open) {
    display: none;
  }
  [data-menu-open] :global(.icon-close) {
    display: block;
  }
</style>
