---
// An Indian highway kilometre stone: gold cap, cream stone, place and km.
import Plane from '@lucide/astro/icons/plane';

interface Props {
  place: string;
  km: number;
  mode?: 'road' | 'air';
  size?: 'sm' | 'md' | 'lg';
  from?: string;
  class?: string;
  style?: string;
}

const { place, km, mode = 'road', size = 'md', from = 'Bengaluru', class: className, style } = Astro.props;
const kmText = km.toLocaleString('en-IN');
const label = `${place}, about ${kmText} km from ${from} by ${mode}`;
---

<div
  class:list={['milestone', size !== 'md' && `milestone-${size}`, className]}
  role="img"
  aria-label={label}
  title={label}
  style={style}
>
  <span class="milestone-cap" aria-hidden="true">
    {mode === 'air' ? <Plane class="milestone-plane" stroke-width={2.4} /> : 'KM'}
  </span>
  <span class="milestone-place" aria-hidden="true">{place}</span>
  <span class="milestone-km" aria-hidden="true">{kmText}</span>
</div>

<style>
  .milestone :global(.milestone-plane) {
    width: 1.35em;
    height: 1.35em;
    margin-bottom: 0.05em;
  }
</style>
