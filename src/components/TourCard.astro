---
import Clock from '@lucide/astro/icons/clock';
import Check from '@lucide/astro/icons/check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Photo from './Photo.astro';
import { durationText, formatINR, tourCategories, type Tour } from '../data/tours';

interface Props {
  tour: Tour;
  showHighlights?: boolean;
  delay?: number;
  class?: string;
}

const { tour, showHighlights = false, delay = 0, class: className } = Astro.props;

const labels = tour.categories
  .map((id) => tourCategories.find((c) => c.id === id)?.label)
  .filter(Boolean)
  .slice(0, 2);
const enquiryService = tour.priceFrom === null ? 'Custom package' : 'Tour package';
const searchText = [tour.name, tour.places, tour.summary, ...tour.highlights, ...labels].join(' ').toLowerCase();
---

<article
  class:list={['tour-card glass group relative flex h-full flex-col overflow-hidden rounded-3xl', className]}
  data-reveal
  style={`--reveal-delay: ${delay}s`}
  data-tour
  data-categories={tour.categories.join(' ')}
  data-days={tour.days}
  data-price={tour.priceFrom ?? ''}
  data-popularity={tour.popularity}
  data-search={searchText}
>
  <div class="relative">
    <Photo
      photo={tour.photo}
      ratio={0.7}
      widths={[480, 720, 960]}
      sizes="(min-width: 1280px) 24rem, (min-width: 768px) 45vw, 92vw"
      class="aspect-[16/10] sm:aspect-[10/7]"
      imgClass="transition duration-700 ease-out group-hover:scale-105"
    />
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink-900/50 to-transparent">
    </div>
    <div class="on-dark absolute top-3 left-3 flex flex-wrap gap-1.5">
      {
        labels.map((label) => (
          <span class="rounded-full border border-fg/20 bg-ink-900/45 px-2.5 py-1 text-[0.7rem] font-medium text-fg backdrop-blur-md">
            {label}
          </span>
        ))
      }
    </div>
    <span class="on-dark absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full border border-fg/20 bg-ink-900/45 px-2.5 py-1 text-[0.72rem] font-medium text-fg backdrop-blur-md">
      <Clock size={13} />
      {durationText(tour)}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="text-xs font-medium tracking-wide text-accent">{tour.places}</p>
    <h3 class="mt-2 text-xl leading-snug font-semibold transition-colors group-hover:text-accent">{tour.name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-fg/70">{tour.summary}</p>

    {
      showHighlights && (
        <ul class="mt-4 grid gap-1.5 text-[0.82rem] text-fg/80">
          {tour.highlights.map((h) => (
            <li class="flex gap-2">
              <Check size={15} class="mt-0.5 shrink-0 text-accent" />
              {h}
            </li>
          ))}
        </ul>
      )
    }

    <a
      href={`/tours/${tour.slug}`}
      class="mt-4 inline-flex items-center gap-1.5 self-start text-sm font-medium text-accent transition-[gap] after:absolute after:inset-0 after:content-[''] hover:gap-2.5"
    >
      View details <ArrowRight size={16} />
      <span class="sr-only">of {tour.name}</span>
    </a>

    <div class="mt-auto pt-5">
      <div class="flex items-center justify-between gap-3 border-t border-line pt-4">
        {
          tour.priceFrom ? (
            <p class="min-w-0">
              <span class="block text-[0.68rem] font-medium tracking-[0.12em] text-fg/55 uppercase">
                From · per person
              </span>
              <span class="text-xl font-semibold tracking-tight text-fg">{formatINR(tour.priceFrom)}</span>
            </p>
          ) : (
            <p class="min-w-0">
              <span class="block text-[0.68rem] font-medium tracking-[0.12em] text-fg/55 uppercase">Price</span>
              <span class="text-lg font-semibold text-fg">On request</span>
            </p>
          )
        }
        <a
          href={`/contact?service=${encodeURIComponent(enquiryService)}&package=${encodeURIComponent(tour.name)}#enquiry`}
          class="btn btn-primary btn-sm relative z-10 shrink-0"
          data-enquire
          data-service={enquiryService}
          data-package={tour.name}
        >
          Enquire<span class="sr-only"> about {tour.name}</span>
        </a>
      </div>
    </div>
  </div>
</article>
