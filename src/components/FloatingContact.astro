---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { site, whatsappHref } from '../data/site';
---

<!-- Desktop and tablet only; phones reach call and WhatsApp from the menu and contact page. -->
<div class="fixed right-6 bottom-6 z-40 hidden sm:flex" data-floating-contact>
  <a
    href={whatsappHref(`Hello ${site.name}, I'd like to plan a trip.`)}
    target="_blank"
    rel="noopener"
    class="fab fab-whatsapp grid size-14 place-items-center rounded-full"
    aria-label="Chat with us on WhatsApp"
  >
    <WhatsAppIcon size={26} />
  </a>
</div>

<style>
  .fab {
    background: var(--color-ocean-500);
    border: 1px solid rgb(255 255 255 / 0.25);
    box-shadow: 0 16px 34px -14px rgb(15 29 51 / 0.6);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: transform 0.25s var(--ease-out-soft);
  }
  .fab:hover {
    transform: translateY(-2px);
  }
  .fab-whatsapp {
    color: #fff;
    background: var(--color-whatsapp);
    border-color: rgb(255 255 255 / 0.3);
  }
</style>
