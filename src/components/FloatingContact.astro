---
import Phone from '@lucide/astro/icons/phone';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { site, telHref, whatsappHref } from '../data/site';
---

<div class="fixed right-4 bottom-4 z-40 flex flex-col gap-3 sm:right-6 sm:bottom-6" data-floating-contact>
  <a
    href={telHref}
    class="fab grid size-13 place-items-center rounded-full text-sand-50 sm:hidden"
    aria-label={`Call ${site.phoneDisplay}`}
  >
    <Phone size={22} />
  </a>
  <a
    href={whatsappHref(`Hello ${site.name}, I'd like to plan a trip.`)}
    target="_blank"
    rel="noopener"
    class="fab fab-whatsapp grid size-13 place-items-center rounded-full sm:size-14"
    aria-label="Chat with us on WhatsApp"
  >
    <WhatsAppIcon size={26} />
  </a>
</div>

<style>
  .fab {
    background: rgb(6 42 46 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.18);
    box-shadow: 0 16px 34px -14px rgb(0 0 0 / 0.7);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: transform 0.25s var(--ease-out-soft);
  }
  .fab:hover {
    transform: translateY(-2px);
  }
  .fab-whatsapp {
    color: #fff;
    background: var(--color-whatsapp);
    border-color: rgb(255 255 255 / 0.3);
  }
</style>
