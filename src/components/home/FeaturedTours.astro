---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import SectionHeading from '../SectionHeading.astro';
import TourCard from '../TourCard.astro';
import { tours } from '../../data/tours';

const featured = tours.filter((t) => t.featured).slice(0, 4);
---

<section class="relative overflow-hidden pt-6 pb-20 sm:pt-10 sm:pb-28" aria-labelledby="featured-title">
  <div
    class="pointer-events-none absolute top-1/3 -left-40 size-[34rem] rounded-full bg-ocean-100/80 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-32 bottom-0 size-[28rem] rounded-full bg-ocean-200/40 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        id="featured-title"
        eyebrow="Popular from Bengaluru"
        title="Trips people keep asking us for"
        intro="Hill weekends a short drive away, and holidays a short flight away. Every package can be changed to suit you."
      />
      <a href="/tours" class="btn btn-ghost shrink-0 self-start sm:self-auto" data-reveal>
        See all packages <ArrowRight size={17} />
      </a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {featured.map((tour, i) => <TourCard tour={tour} delay={i * 0.08} />)}
    </div>
  </div>
</section>
