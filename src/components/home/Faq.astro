---
import Plus from '@lucide/astro/icons/plus';
import Phone from '@lucide/astro/icons/phone';
import SectionHeading from '../SectionHeading.astro';
import WhatsAppIcon from '../WhatsAppIcon.astro';
import { faqs } from '../../data/faqs';
import { site, telHref, whatsappHref } from '../../data/site';
---

<section class="relative overflow-hidden py-20 text-ink-800 sm:py-28" aria-labelledby="faq-title">
  <div
    class="pointer-events-none absolute top-10 -left-24 size-[22rem] rounded-full bg-ocean-200/50 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="wrap relative grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeading
        id="faq-title"
        eyebrow="Before you book"
        title="Questions we get asked a lot"
        intro="Can't find your answer here? Ask us directly. We're happy to talk through your plan."
      />
      <div class="glass-light mt-8 rounded-3xl p-6" data-reveal>
        <p class="font-semibold">Talk to a person</p>
        <p class="mt-1 text-sm text-ink-800/70">Call or message {site.phoneDisplay}.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={telHref} class="btn btn-ink btn-sm"><Phone size={15} /> Call now</a>
          <a href={whatsappHref()} target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm">
            <WhatsAppIcon size={15} /> WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="grid gap-3" data-reveal>
      {
        faqs.map((faq, i) => (
          <details class="faq glass-light rounded-2xl" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left font-medium sm:px-6 sm:py-5">
              <span>{faq.q}</span>
              <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full bg-ocean-50 text-ocean-600">
                <Plus size={16} />
              </span>
            </summary>
            <div class="px-5 pb-5 text-[0.95rem] leading-relaxed text-ink-800/75 sm:px-6 sm:pb-6">
              <p>{faq.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary {
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    transition:
      transform 0.3s var(--ease-out-soft),
      background 0.2s ease;
  }
  .faq[open] .faq-icon {
    transform: rotate(45deg);
    background: var(--color-ocean-500);
    color: #ffffff;
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: 1rem;
  }
</style>
