---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Plane from '@lucide/astro/icons/plane';
import CarFront from '@lucide/astro/icons/car-front';
import BusFront from '@lucide/astro/icons/bus-front';
import Compass from '@lucide/astro/icons/compass';

const tabs = [
  {
    value: 'Airport transfer',
    label: 'Airport',
    Icon: Plane,
    pickup: 'Your area, e.g. JP Nagar',
    destination: 'Kempegowda International Airport',
  },
  {
    value: 'Outstation cab',
    label: 'Outstation',
    Icon: CarFront,
    pickup: 'Pickup area in Bengaluru',
    destination: 'Mysuru, Coorg, Ooty...',
  },
  {
    value: 'Tempo Traveller / bus hire',
    label: 'Tempo & bus',
    Icon: BusFront,
    pickup: 'Where the group starts',
    destination: 'Where the group is going',
  },
  {
    value: 'Tour package',
    label: 'Tour',
    Icon: Compass,
    pickup: 'Starting from Bengaluru',
    destination: 'Kerala, Goa, Dubai, Bali...',
  },
];
---

<section
  class="hero on-dark relative isolate overflow-hidden bg-ink-900 pt-0 pb-12 lg:flex lg:min-h-[100svh] lg:items-end lg:bg-transparent lg:pt-32 lg:pb-24"
  aria-labelledby="hero-title"
>
  <div class="hero-glow absolute inset-0 -z-30 lg:hidden" aria-hidden="true"></div>

  <div class="wrap grid items-end gap-0 lg:grid-cols-12 lg:gap-12">
    <div class="hero-copy relative z-10 -mt-14 text-center sm:-mt-20 lg:col-span-7 lg:mt-0 lg:text-left">
      <h1
        id="hero-title"
        class="text-[2.75rem] leading-[0.95] font-semibold tracking-[-0.045em] sm:text-7xl lg:text-[5.75rem]"
      >
        <span class="rise block font-light" style="--d: 0.18s">Your ride out</span>
        <span class="rise block" style="--d: 0.3s">of Bengaluru<span class="text-gold-300">.</span></span>
      </h1>
    </div>

    <!-- Phones and tablets: a full-width square at the very top of the page (heading below it) that fades into the background at top and bottom.
         Desktop: the same element stretches behind the whole hero. -->
    <div
      class="hero-media rise relative order-first -mx-4 aspect-square overflow-hidden sm:-mx-6 lg:absolute lg:inset-0 lg:-z-20 lg:order-none lg:mx-0 lg:aspect-auto lg:[animation:none]"
      style="--d: 0.4s"
    >
      <video
        class="hero-video absolute inset-0 h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/video/hero-poster.jpg"
        aria-hidden="true"
        data-hero-video
      >
        <source src="/video/hero-720.mp4" type="video/mp4" media="(max-width: 767px)" />
        <source src="/video/hero-1080.mp4" type="video/mp4" />
      </video>
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 mx-3 mt-6 sm:mx-8 sm:mt-8 lg:col-span-5 lg:mx-0 lg:mt-0">
      <form
        class="rise glass rounded-[1.25rem] p-4 lg:rounded-3xl lg:p-7"
        style="--d: 0.5s"
        action="/contact"
        method="get"
        data-quick-planner
      >
        <h2 class="text-[1.05rem] font-semibold lg:text-xl">Plan a trip</h2>
        <p class="mt-1 hidden text-sm text-fg/65 lg:block">Pick a service, add the basics, and we'll send a quote.</p>

        <fieldset class="mt-3 lg:mt-5">
          <legend class="sr-only">Service</legend>
          <div class="grid grid-cols-4 gap-1 rounded-2xl border border-line bg-ink-950/35 p-1">
            {
              tabs.map((t, i) => (
                <label class="tab">
                  <input
                    type="radio"
                    name="service"
                    value={t.value}
                    checked={i === 0}
                    class="sr-only"
                    data-pickup={t.pickup}
                    data-destination={t.destination}
                  />
                  <t.Icon size={18} />
                  <span>{t.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="mt-2.5 grid grid-cols-2 gap-2 lg:mt-4 lg:gap-3">
          <div class="col-span-2">
            <label class="field-label" for="qp-pickup">Pickup</label>
            <input class="field" id="qp-pickup" name="pickup" placeholder={tabs[0].pickup} />
          </div>
          <div class="col-span-2">
            <label class="field-label" for="qp-destination">Drop or destination</label>
            <input class="field" id="qp-destination" name="destination" placeholder={tabs[0].destination} />
          </div>
          <div>
            <label class="field-label" for="qp-date">Date</label>
            <input class="field" id="qp-date" name="date" type="date" data-min-today />
          </div>
          <div>
            <label class="field-label" for="qp-passengers">Travellers</label>
            <input
              class="field"
              id="qp-passengers"
              name="passengers"
              type="number"
              min="1"
              max="500"
              inputmode="numeric"
              placeholder="2"
            />
          </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3 min-h-[2.6rem] w-full lg:mt-5">
          Book now <ArrowRight size={18} />
        </button>
        <p class="mt-3 hidden text-center text-xs text-fg/55 lg:block">Quotes are free. Nothing to pay until you confirm.</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { openEnquiry } from '../../scripts/enquiry';

  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }

  // Phones and tablets show a square crop of the 16:9 clip. The Tempo
  // Traveller drifts right as the clip plays, so pan the crop with it to keep
  // it centred. Points are [seconds, bus centre as a fraction of frame width],
  // measured from the source clip; update them if the video is replaced.
  const busPath: [number, number][] = [
    [0, 0.289],
    [2, 0.313],
    [4, 0.341],
    [6, 0.367],
    [7, 0.373],
    [8, 0.381],
    [10, 0.406],
    [10.2, 0.406],
  ];
  const cropWidth = 9 / 16; // a square crop of a 16:9 frame
  const busAt = (t: number) => {
    for (let i = 1; i < busPath.length; i++) {
      const [t1, x1] = busPath[i];
      const [t0, x0] = busPath[i - 1];
      if (t <= t1) return x0 + ((x1 - x0) * (t - t0)) / (t1 - t0);
    }
    return busPath[busPath.length - 1][1];
  };
  // The served clip starts 1.25s into the source and dissolves back into the
  // source's first 1.25s over its last 1.25s, so it loops without a jump.
  // Map playback time onto the source path, blending across the dissolve.
  const loopTrim = 1.25;
  const fadeStart = 7.625;
  const busOnScreen = (t: number) => {
    const x = busAt(t + loopTrim);
    if (t <= fadeStart) return x;
    const a = Math.min((t - fadeStart) / loopTrim, 1);
    return x + (busAt(t - fadeStart) - x) * a;
  };
  const mobile = window.matchMedia('(max-width: 1023px)');
  if (video) {
    const pan = () => {
      if (!mobile.matches) {
        video.style.transform = '';
        return;
      }
      // Left edge of the crop, as a fraction of the frame, clamped to the frame.
      const left = Math.min(Math.max(busOnScreen(video.currentTime) - cropWidth / 2, 0), 1 - cropWidth);
      video.style.transform = `translate3d(${(-left * 100).toFixed(3)}%, 0, 0)`;
    };
    const rvfc = 'requestVideoFrameCallback' in HTMLVideoElement.prototype;
    const loop = () => {
      pan();
      if (rvfc) video.requestVideoFrameCallback(loop);
      else if (!video.paused) requestAnimationFrame(loop);
    };
    loop();
    if (!rvfc) video.addEventListener('play', () => requestAnimationFrame(loop));
    video.addEventListener('seeked', pan);
    mobile.addEventListener('change', pan);
  }

  const form = document.querySelector<HTMLFormElement>('[data-quick-planner]');
  if (form) {
    const pickup = form.querySelector<HTMLInputElement>('[name="pickup"]')!;
    const destination = form.querySelector<HTMLInputElement>('[name="destination"]')!;
    const date = form.querySelector<HTMLInputElement>('[name="date"]')!;

    const d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    date.min = d.toISOString().slice(0, 10);

    form.addEventListener('change', (e) => {
      const radio = e.target as HTMLInputElement;
      if (radio.name !== 'service') return;
      pickup.placeholder = radio.dataset.pickup ?? '';
      destination.placeholder = radio.dataset.destination ?? '';
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const value = (k: string) => String(data.get(k) ?? '').trim() || undefined;
      openEnquiry({
        service: value('service'),
        pickup: value('pickup'),
        destination: value('destination'),
        travelDate: value('date'),
        passengers: value('passengers'),
      });
    });
  }
</script>

<style>
  @media (max-width: 1023px) {
    /* The square crop is made by sizing the video to its full 16:9 width and
       sliding it with a transform (see busPath above), which keeps the
       Tempo Traveller centred and runs on the GPU. The default matches the
       first frame so the poster lines up before the script runs. */
    .hero-video {
      width: calc(100% * 16 / 9);
      max-width: none;
      transform: translate3d(-0.8%, 0, 0);
      will-change: transform;
    }
  }
  .hero-glow {
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(31 95 191 / 0.35) 0%, transparent 60%),
      radial-gradient(90% 50% at 0% 100%, rgb(201 154 46 / 0.12) 0%, transparent 60%);
  }
  @media (max-width: 1023px) {
    /* Phones and tablets: fade the video itself out at the top and bottom so it melts into the hero background. */
    .hero-media {
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 62%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 62%, transparent 100%);
    }
  }
  @media (max-width: 1023px) {
    /* Phones and tablets: a light card that stands out against the dark hero.
       It switches the dark-theme tokens back to their light values for everything inside. */
    .hero .glass {
      --color-fg: var(--color-ink-900);
      --color-accent: var(--color-ocean-500);
      --color-line: rgb(255 255 255 / 0.9);
      --field-bg: #ffffff;
      --field-bg-focus: #ffffff;
      --field-border: transparent;
      --field-border-hover: var(--color-ocean-200);
      --field-scheme: light;
      color: var(--color-fg);
      background: #d9e1ec;
      border-color: rgb(255 255 255 / 0.85);
      box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    [data-quick-planner] fieldset > div {
      background: #eef2f8;
      border-color: #ffffff;
    }
    [data-quick-planner] .tab {
      color: rgb(15 29 51 / 0.72);
    }
    [data-quick-planner] .tab:hover {
      color: var(--color-ink-900);
      background: rgb(15 29 51 / 0.05);
    }
    [data-quick-planner] .tab:has(input:checked) {
      color: #ffffff;
      background: var(--color-ocean-500);
    }
    [data-quick-planner] .field-label {
      color: var(--color-ocean-700);
      font-weight: 600;
    }
    [data-quick-planner] .field {
      box-shadow: 0 1px 2px rgb(15 29 51 / 0.06);
    }
    [data-quick-planner] .field:focus {
      border-color: var(--color-ocean-400);
      box-shadow: 0 0 0 3px rgb(75 134 217 / 0.22);
    }
  }
  @media (min-width: 1024px) {
    .hero-video {
      object-position: 30% 50%;
    }
    .hero-scrim {
    /* Neutral shade only where text sits, so the video keeps its own colour and light. */
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0) 22%, rgb(0 0 0 / 0) 55%, rgb(0 0 0 / 0.55) 100%),
      linear-gradient(90deg, rgb(0 0 0 / 0.4) 0%, rgb(0 0 0 / 0) 60%);
    }
  }
  .hero-copy {
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.55),
      0 2px 18px rgb(0 0 0 / 0.45);
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.25rem;
    border-radius: 0.8rem;
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
    color: rgb(243 247 252 / 0.7);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .tab:hover {
    color: #ffffff;
    background: rgb(255 255 255 / 0.06);
  }
  .tab:has(input:checked) {
    color: #ffffff;
    background: var(--color-ocean-500);
    box-shadow: 0 8px 18px -10px rgb(31 95 191 / 0.9);
  }
  .tab:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (min-width: 640px) {
    .tab {
      font-size: 0.75rem;
    }
  }
  @media (max-width: 1023px) {
    /* Compact trip planner on phones and tablets. */
    .tab {
      gap: 0.2rem;
      padding: 0.4rem 0.2rem;
      font-size: 0.68rem;
    }
    .tab :global(svg) {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
    [data-quick-planner] .field-label {
      margin-bottom: 0.25rem;
      font-size: 0.78rem;
    }
    [data-quick-planner] .field {
      min-height: 2.4rem;
      padding-block: 0.4rem;
      font-size: 0.88rem;
    }
  }
</style>
