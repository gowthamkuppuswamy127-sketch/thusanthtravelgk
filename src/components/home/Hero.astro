---
import Phone from '@lucide/astro/icons/phone';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Plane from '@lucide/astro/icons/plane';
import CarFront from '@lucide/astro/icons/car-front';
import BusFront from '@lucide/astro/icons/bus-front';
import Compass from '@lucide/astro/icons/compass';
import Photo from '../Photo.astro';
import Milestone from '../Milestone.astro';
import Stars from '../Stars.astro';
import { heroMilestones, site, telHref } from '../../data/site';

const tabs = [
  {
    value: 'Airport transfer',
    label: 'Airport',
    Icon: Plane,
    pickup: 'Your area, e.g. JP Nagar',
    destination: 'Kempegowda International Airport',
  },
  {
    value: 'Outstation cab',
    label: 'Outstation',
    Icon: CarFront,
    pickup: 'Pickup area in Bengaluru',
    destination: 'Mysuru, Coorg, Ooty...',
  },
  {
    value: 'Tempo Traveller / bus hire',
    label: 'Tempo & bus',
    Icon: BusFront,
    pickup: 'Where the group starts',
    destination: 'Where the group is going',
  },
  {
    value: 'Tour package',
    label: 'Tour',
    Icon: Compass,
    pickup: 'Starting from Bengaluru',
    destination: 'Kerala, Goa, Dubai, Bali...',
  },
];
---

<section
  class="hero relative isolate flex min-h-[100svh] items-end overflow-hidden pt-28 pb-16 sm:pb-20 lg:items-center lg:pt-32 lg:pb-24"
  aria-labelledby="hero-title"
>
  <Photo
    photo="mistyHills"
    alt=""
    eager
    widths={[800, 1280, 1920, 2560]}
    sizes="100vw"
    class="absolute inset-0 -z-20"
    imgClass="hero-img"
  />
  <div class="hero-scrim absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="wrap grid items-end gap-12 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <p class="eyebrow rise" style="--d: 0.1s">Cabs&nbsp;· Tempo&nbsp;Travellers&nbsp;· Tours&nbsp;· Hotels</p>
      <h1
        id="hero-title"
        class="mt-6 text-[3.25rem] leading-[0.95] font-semibold tracking-[-0.045em] sm:text-7xl lg:text-[5.75rem]"
      >
        <span class="rise block font-light" style="--d: 0.18s">Bengaluru</span>
        <span class="rise block" style="--d: 0.3s">to anywhere<span class="text-gold-300">.</span></span>
      </h1>
      <p class="rise mt-6 max-w-xl text-base leading-relaxed text-sand-100/80 sm:text-lg" style="--d: 0.42s">
        Airport transfers, outstation cabs, Tempo Traveller and bus hire, and holidays across India and abroad.
        Planned and driven by a Banashankari team rated {site.rating} on Google.
      </p>
      <div class="rise mt-8 flex flex-wrap items-center gap-3" style="--d: 0.52s">
        <a href="/contact#enquiry" class="btn btn-gold" data-enquire>
          Book now <ArrowRight size={18} />
        </a>
        <a href={telHref} class="btn btn-glass">
          <Phone size={17} /> Call {site.phoneDisplay}
        </a>
      </div>
      <a
        href={site.reviewsUrl}
        target="_blank"
        rel="noopener"
        class="rise mt-6 inline-flex items-center gap-2.5 text-sm text-sand-100/75 transition hover:text-sand-50"
        style="--d: 0.6s"
      >
        <Stars rating={site.rating} size={15} />
        <span><strong class="font-semibold text-sand-50">{site.rating}</strong> from {site.reviewCount} Google reviews</span>
      </a>

      <div class="mt-12">
        <p class="rise text-[0.68rem] font-medium tracking-[0.2em] text-sand-100/60 uppercase" style="--d: 0.7s">
          Road distance from our Banashankari office, in km
        </p>
        <div class="stones mt-4 flex items-end gap-4 sm:gap-6">
          {
            heroMilestones.map((m, i) => (
              <Milestone
                place={m.place}
                km={m.km}
                from="Banashankari"
                class="rise"
                style={`--d: ${0.8 + i * 0.12}s`}
              />
            ))
          }
        </div>
      </div>
    </div>

    <div class="lg:col-span-5">
      <form
        class="rise glass rounded-3xl p-5 sm:p-7"
        style="--d: 0.5s"
        action="/contact"
        method="get"
        data-quick-planner
      >
        <h2 class="text-xl font-semibold">Plan a trip</h2>
        <p class="mt-1 text-sm text-sand-100/65">Pick a service, add the basics, and we'll send a quote.</p>

        <fieldset class="mt-5">
          <legend class="sr-only">Service</legend>
          <div class="grid grid-cols-4 gap-1 rounded-2xl border border-white/10 bg-ink-950/35 p-1">
            {
              tabs.map((t, i) => (
                <label class="tab">
                  <input
                    type="radio"
                    name="service"
                    value={t.value}
                    checked={i === 0}
                    class="sr-only"
                    data-pickup={t.pickup}
                    data-destination={t.destination}
                  />
                  <t.Icon size={18} />
                  <span>{t.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="col-span-2">
            <label class="field-label" for="qp-pickup">Pickup</label>
            <input class="field" id="qp-pickup" name="pickup" placeholder={tabs[0].pickup} />
          </div>
          <div class="col-span-2">
            <label class="field-label" for="qp-destination">Drop or destination</label>
            <input class="field" id="qp-destination" name="destination" placeholder={tabs[0].destination} />
          </div>
          <div>
            <label class="field-label" for="qp-date">Date</label>
            <input class="field" id="qp-date" name="date" type="date" data-min-today />
          </div>
          <div>
            <label class="field-label" for="qp-passengers">Travellers</label>
            <input
              class="field"
              id="qp-passengers"
              name="passengers"
              type="number"
              min="1"
              max="500"
              inputmode="numeric"
              placeholder="2"
            />
          </div>
        </div>

        <button type="submit" class="btn btn-gold mt-5 w-full">
          Book now <ArrowRight size={18} />
        </button>
        <p class="mt-3 text-center text-xs text-sand-100/55">Quotes are free. Nothing to pay until you confirm.</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { openEnquiry } from '../../scripts/enquiry';

  const form = document.querySelector<HTMLFormElement>('[data-quick-planner]');
  if (form) {
    const pickup = form.querySelector<HTMLInputElement>('[name="pickup"]')!;
    const destination = form.querySelector<HTMLInputElement>('[name="destination"]')!;
    const date = form.querySelector<HTMLInputElement>('[name="date"]')!;

    const d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    date.min = d.toISOString().slice(0, 10);

    form.addEventListener('change', (e) => {
      const radio = e.target as HTMLInputElement;
      if (radio.name !== 'service') return;
      pickup.placeholder = radio.dataset.pickup ?? '';
      destination.placeholder = radio.dataset.destination ?? '';
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const value = (k: string) => String(data.get(k) ?? '').trim() || undefined;
      openEnquiry({
        service: value('service'),
        pickup: value('pickup'),
        destination: value('destination'),
        travelDate: value('date'),
        passengers: value('passengers'),
      });
    });
  }
</script>

<style>
  .hero :global(.hero-img) {
    animation: hero-drift 14s var(--ease-out-soft) both;
  }
  @keyframes hero-drift {
    from {
      transform: scale(1.1);
    }
    to {
      transform: scale(1);
    }
  }
  .hero-scrim {
    background:
      linear-gradient(180deg, rgb(4 28 30 / 0.7) 0%, rgb(4 28 30 / 0.2) 28%, rgb(4 28 30 / 0.55) 62%, var(--color-ink-800) 100%),
      linear-gradient(90deg, rgb(4 28 30 / 0.85) 0%, rgb(4 28 30 / 0.45) 55%, rgb(4 28 30 / 0.15) 100%),
      radial-gradient(60% 50% at 85% 15%, rgb(224 182 82 / 0.18), transparent 70%);
  }
  .stones {
    position: relative;
    padding-inline: 0.25rem;
  }
  .stones::after {
    content: '';
    position: absolute;
    left: -2rem;
    right: -1rem;
    bottom: -2px;
    height: 2px;
    background: repeating-linear-gradient(90deg, rgb(233 201 124 / 0.6) 0 16px, transparent 16px 28px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 70%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 70%, transparent);
  }
  .stones :global(.milestone) {
    --w: 3.7rem;
  }
  @media (min-width: 640px) {
    .stones :global(.milestone) {
      --w: 4.6rem;
    }
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.25rem;
    border-radius: 0.8rem;
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
    color: rgb(246 239 226 / 0.7);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .tab:hover {
    color: var(--color-sand-50);
    background: rgb(255 255 255 / 0.06);
  }
  .tab:has(input:checked) {
    color: var(--color-ink-900);
    background: linear-gradient(180deg, var(--color-gold-200), var(--color-gold-300));
    box-shadow: 0 8px 18px -10px rgb(224 182 82 / 0.9);
  }
  .tab:has(input:focus-visible) {
    outline: 2px solid var(--color-gold-300);
    outline-offset: 2px;
  }
  @media (min-width: 640px) {
    .tab {
      font-size: 0.75rem;
    }
  }
</style>
