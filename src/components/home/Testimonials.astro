---
import Quote from '@lucide/astro/icons/quote';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SectionHeading from '../SectionHeading.astro';
import Stars from '../Stars.astro';
import { testimonials } from '../../data/testimonials';
import { site } from '../../data/site';
---

<section class="relative overflow-hidden bg-ocean-50 py-20 sm:py-28" aria-labelledby="reviews-title" data-carousel>
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-72 w-[60rem] -translate-x-1/2 rounded-full bg-ocean-200/40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="wrap relative">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="reviews-title"
        eyebrow="Traveller reviews"
        title="What our travellers say"
        intro={`Rated ${site.rating} out of 5 across ${site.reviewCount} Google reviews.`}
      />
      <div class="flex items-center gap-3" data-reveal>
        <a
          href={site.reviewsUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost btn-sm"
        >
          Read reviews on Google <ArrowUpRight size={16} />
        </a>
        <button type="button" class="carousel-btn" data-prev aria-label="Previous reviews">
          <ChevronLeft size={20} />
        </button>
        <button type="button" class="carousel-btn" data-next aria-label="Next reviews">
          <ChevronRight size={20} />
        </button>
      </div>
    </div>

    <ul
      class="no-scrollbar -mx-4 mt-12 flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:scroll-px-6 sm:px-6 lg:mx-0 lg:scroll-px-0 lg:px-0"
      data-track
      tabindex="0"
      aria-label="Reviews, scroll sideways for more"
    >
      {
        testimonials.map((t) => (
          <li class="glass flex w-[86%] shrink-0 snap-start flex-col rounded-3xl p-6 sm:w-[46%] sm:p-7 lg:w-[calc((100%-2.5rem)/3)]">
            <div class="flex items-center justify-between">
              <Stars rating={t.rating} size={16} />
              <Quote size={30} class="text-accent/40" />
            </div>
            <blockquote class="mt-5 flex-1 text-[0.98rem] leading-relaxed text-fg/90">
              <p>{t.quote}</p>
            </blockquote>
            <div class="mt-6 flex items-center gap-3 border-t border-line pt-5">
              <span class="grid size-11 place-items-center rounded-full bg-gradient-to-br from-ocean-400 to-ocean-600 font-semibold text-white">
                {t.name.charAt(0)}
              </span>
              <div>
                <p class="font-medium">{t.name}</p>
                <p class="text-xs text-fg/60">{t.trip}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .carousel-btn {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: #ffffff;
    color: var(--color-fg);
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }
  .carousel-btn:hover {
    background: var(--color-ocean-100);
  }
  .carousel-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !prev || !next) return;

    const step = () => {
      const card = track.querySelector<HTMLElement>('li');
      return card ? card.offsetWidth + 20 : track.clientWidth * 0.8;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
