---
import Quote from '@lucide/astro/icons/quote';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SectionHeading from '../SectionHeading.astro';
import Stars from '../Stars.astro';
import { testimonials } from '../../data/testimonials';
import { site } from '../../data/site';
---

<section class="relative overflow-hidden bg-ocean-50 py-20 sm:py-28" aria-labelledby="reviews-title">
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-72 w-[60rem] -translate-x-1/2 rounded-full bg-ocean-200/40 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="wrap relative">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="reviews-title"
        eyebrow="Traveller reviews"
        title="What our travellers say"
        intro={`Rated ${site.rating} out of 5 across ${site.reviewCount} Google reviews.`}
      />
      <div class="flex items-center gap-3" data-reveal>
        <a
          href={site.reviewsUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost btn-sm"
        >
          Read reviews on Google <ArrowUpRight size={16} />
        </a>
      </div>
    </div>

  </div>

  <!-- Reviews drift slowly from left to right, and visitors can also swipe or drag them. The list is
       rendered twice so the loop is seamless; the copy is hidden from screen readers. -->
  <div
    class="marquee no-scrollbar relative mt-10 -mb-10"
    aria-label="Traveller reviews, swipe or drag to see more"
    role="region"
    tabindex="0"
    data-marquee
  >
    <div class="marquee-track flex w-max">
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0 gap-5 pt-2 pr-5 pb-12" aria-hidden={copy === 1 ? 'true' : undefined}>
            {testimonials.map((t) => (
              <li class="glass flex w-[18.5rem] shrink-0 flex-col rounded-3xl p-6 sm:w-[23rem] sm:p-7">
                <div class="flex items-center justify-between">
                  <Stars rating={t.rating} size={16} />
                  <Quote size={30} class="text-accent/40" />
                </div>
                <blockquote class="mt-5 flex-1 text-[0.98rem] leading-relaxed text-fg/90">
                  <p>{t.quote}</p>
                </blockquote>
                <div class="mt-6 flex items-center gap-3 border-t border-line pt-5">
                  <span class="grid size-11 place-items-center rounded-full bg-gradient-to-br from-ocean-400 to-ocean-600 font-semibold text-white">
                    {t.name.charAt(0)}
                  </span>
                  <div>
                    <p class="font-medium">{t.name}</p>
                    <p class="text-xs text-fg/60">{t.trip}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: auto;
    cursor: grab;
    /* Soft fade at both edges so cards slide in and out of view. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .marquee:focus-visible {
    outline-offset: -3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      padding-inline: 1rem;
    }
    .marquee-track > ul[aria-hidden] {
      display: none;
    }
  }
</style>

<script>
  // Auto-scrolls the reviews to the right, lets people swipe (touch), drag (mouse), scroll or use
  // the arrow keys, and picks the automatic movement back up a moment after they let go.
  const root = document.querySelector<HTMLElement>('[data-marquee]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduceMotion) {
    const SPEED = 25; // pixels per second
    const RESUME_AFTER = 2500; // ms after the visitor stops interacting

    // One copy of the list is exactly half the scroll width. Keeping scrollLeft inside
    // (0, half] and jumping by one copy at the ends makes the strip endless in both directions.
    const half = () => root.scrollWidth / 2;
    const wrap = () => {
      const h = half();
      const shift = root.scrollLeft <= 1 ? h : root.scrollLeft > h + 1 ? -h : 0;
      if (!shift) return;
      root.scrollLeft += shift;
      dragStart += shift; // keep an in-progress mouse drag in step with the jump
    };

    let dragX = 0;
    let dragStart = 0;
    let hovering = false;
    let holding = false;
    let idleUntil = 0;
    let visible = true;
    let pos = (root.scrollLeft = half());
    let last = performance.now();

    const nudge = () => {
      idleUntil = performance.now() + RESUME_AFTER;
    };

    const tick = (now: number) => {
      const dt = Math.min(now - last, 100) / 1000;
      last = now;
      if (visible && !hovering && !holding && now > idleUntil) {
        // Pick up wherever the visitor left it, then move left-to-right by lowering scrollLeft.
        if (Math.abs(root.scrollLeft - pos) > 2) pos = root.scrollLeft;
        pos -= SPEED * dt;
        root.scrollLeft = pos;
        if (pos <= 1) {
          pos += half();
          root.scrollLeft = pos;
        }
      } else {
        pos = root.scrollLeft;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    root.addEventListener('scroll', wrap, { passive: true });
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(root);

    // Mouse: pause on hover, drag to slide. Touch and trackpads use the browser's own scrolling.
    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') hovering = true;
    });
    root.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') hovering = false;
    });

    root.addEventListener('pointerdown', (e) => {
      holding = true;
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragX = e.clientX;
      dragStart = root.scrollLeft;
      root.setPointerCapture(e.pointerId);
      root.classList.add('is-dragging');
    });
    root.addEventListener('pointermove', (e) => {
      if (!root.classList.contains('is-dragging')) return;
      root.scrollLeft = dragStart - (e.clientX - dragX);
    });
    const release = () => {
      holding = false;
      root.classList.remove('is-dragging');
      nudge();
    };
    root.addEventListener('pointerup', release);
    root.addEventListener('pointercancel', release);
    root.addEventListener('touchend', release, { passive: true });
    root.addEventListener('wheel', nudge, { passive: true });
    root.addEventListener('keydown', nudge);
    root.addEventListener('focusin', () => (holding = true));
    root.addEventListener('focusout', release);
  }
</script>
