---
import Plane from '@lucide/astro/icons/plane';
import Bus from '@lucide/astro/icons/bus';
import Compass from '@lucide/astro/icons/compass';
import Hotel from '@lucide/astro/icons/hotel';
import Check from '@lucide/astro/icons/check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Photo from '../Photo.astro';
import SectionHeading from '../SectionHeading.astro';
import { services } from '../../data/services';

const icons = { plane: Plane, bus: Bus, compass: Compass, hotel: Hotel };
---

<section class="relative py-20 sm:py-28" aria-labelledby="services-title">
  <div class="wrap">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="services-title"
        eyebrow="What we do"
        title="Cabs, coaches, tours and stays"
      />
      <p class="max-w-md text-base leading-relaxed text-fg/70 lg:pb-2" data-reveal>
        Book a single airport drop or a two-week holiday. Either way you deal with one team, on one phone number.
      </p>
    </div>

    <ul
      class="no-scrollbar -mx-4 mt-12 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 lg:grid-cols-4"
    >
      {
        services.map((s, i) => {
          const Icon = icons[s.icon];
          return (
            <li
              class="service-card on-dark group relative w-[84%] shrink-0 snap-start overflow-hidden rounded-3xl sm:w-[60%] md:w-auto"
              data-reveal
              style={`--reveal-delay: ${i * 0.08}s`}
            >
              <Photo
                photo={s.photo}
                alt=""
                ratio={1.35}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 84vw"
                class="absolute inset-0"
                imgClass="transition duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-b from-ink-900/10 via-ink-900/10 to-ink-900/85" />
              <div class="relative flex h-full min-h-[27rem] flex-col justify-end p-3 sm:min-h-[29rem]">
                <div class="glass rounded-2xl p-5">
                  <div class="flex items-center gap-3">
                    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-ocean-500 text-white">
                      <Icon size={20} />
                    </span>
                    <h3 class="text-lg leading-tight font-semibold">{s.title}</h3>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-fg/80">{s.blurb}</p>
                  <ul class="mt-3 grid gap-1.5 text-[0.82rem] text-fg/85">
                    {s.points.map((p) => (
                      <li class="flex gap-2">
                        <Check size={15} class="mt-0.5 shrink-0 text-accent" />
                        {p}
                      </li>
                    ))}
                  </ul>
                  <a
                    href={`/contact?service=${encodeURIComponent(s.enquiry)}#enquiry`}
                    class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition hover:gap-2.5"
                    data-enquire
                    data-service={s.enquiry}
                  >
                    Get a quote <ArrowRight size={16} />
                    <span class="sr-only">for {s.title.toLowerCase()}</span>
                  </a>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
