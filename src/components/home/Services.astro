---
import Plane from '@lucide/astro/icons/plane';
import BusFront from '@lucide/astro/icons/bus-front';
import Compass from '@lucide/astro/icons/compass';
import Hotel from '@lucide/astro/icons/hotel';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Photo from '../Photo.astro';
import SectionHeading from '../SectionHeading.astro';
import { services } from '../../data/services';

const icons = { plane: Plane, bus: BusFront, compass: Compass, hotel: Hotel };
---

<section class="relative py-20 sm:py-28" aria-labelledby="services-title">
  <div class="wrap">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="services-title"
        eyebrow="What we do"
        title="Cabs, coaches, tours and stays"
      />
      <p class="max-w-md text-base leading-relaxed text-fg/70 lg:pb-2" data-reveal>
        Book a single airport drop or a two-week holiday. Either way you deal with one team, on one phone number.
      </p>
    </div>

    <ul
      class="no-scrollbar -mx-4 mt-12 flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pt-1 pb-8 sm:-mx-6 sm:scroll-px-6 sm:px-6 md:mx-0 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-4"
    >
      {
        services.map((s, i) => {
          const Icon = icons[s.icon];
          return (
            <li
              class="group relative flex w-[84%] shrink-0 snap-start flex-col overflow-hidden rounded-3xl border border-line bg-white shadow-[0_24px_48px_-28px_rgb(15_29_51/0.35)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_32px_56px_-28px_rgb(15_29_51/0.45)] sm:w-[58%] md:w-auto"
              data-reveal
              style={`--reveal-delay: ${i * 0.08}s`}
            >
              <div class="relative">
                <Photo
                  photo={s.photo}
                  alt=""
                  ratio={0.75}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 84vw"
                  class="aspect-[4/3]"
                  imgClass="transition duration-700 ease-out group-hover:scale-105"
                />
                <span class="absolute top-4 left-4 inline-flex items-center gap-2.5 rounded-full bg-white/95 py-1.5 pr-4 pl-1.5 text-sm font-semibold text-ink-800 shadow-sm backdrop-blur">
                  <span class="grid size-8 place-items-center rounded-full bg-ocean-500 text-white">
                    <Icon size={16} />
                  </span>
                  {s.badge}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <h3 class="text-xl leading-snug font-semibold">{s.title}</h3>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-fg/70">{s.blurb}</p>
                <a
                  href={`/contact?service=${encodeURIComponent(s.enquiry)}#enquiry`}
                  class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[0.95rem] font-medium text-accent transition-[gap] after:absolute after:inset-0 after:content-[''] hover:gap-2.5"
                  data-enquire
                  data-service={s.enquiry}
                >
                  Get a quote <ArrowRight size={17} />
                  <span class="sr-only">for {s.title.toLowerCase()}</span>
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
