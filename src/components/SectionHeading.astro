---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  id?: string;
  class?: string;
}

const { eyebrow, title, intro, align = 'left', id, class: className } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl', className]} data-reveal>
  {eyebrow && <p class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</p>}
  <h2 id={id} class="mt-4 text-3xl leading-[1.12] font-semibold sm:text-4xl lg:text-[2.75rem]">{title}</h2>
  {intro && <p class="mt-4 text-base leading-relaxed opacity-75 sm:text-lg">{intro}</p>}
  <slot />
</div>
